cat > /workspaces/herald-portal/.env.example << 'EOF'
# Copy this file to .env for local dev (never commit .env)
# For Render: set these in the Environment tab of your service

JWT_SECRET=change-me-to-a-long-random-string

# Database location (Render persistent disk)
# DATA_DIR=/var/data

# Upload location for PDF submissions (Render persistent disk)
# UPLOAD_DIR=/var/data/uploads
EOF