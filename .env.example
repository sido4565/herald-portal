cat > /workspaces/herald-portal/.env.example << 'EOF'
# Copy this file to .env for local dev (never commit .env)
# For Render: set these in the Environment tab of your service

JWT_SECRET=change-me-to-a-long-random-string

# LiveKit Cloud (set only in the backend environment; never in browser variables)
# Copy the WebSocket URL, API key, and API secret from the Herald Trainer LiveKit project.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional: delay server termination slightly after scheduled end (minutes; default 0)
LIVE_CLASS_JOIN_GRACE_MINUTES=0
# Africa/Nairobi is UTC+3 (used for datetime-local schedule forms and attendance dates)
LIVE_CLASS_TIMEZONE_OFFSET_MINUTES=180

# Database location (Render persistent disk)
# DATA_DIR=/var/data

# Upload location for PDF submissions (Render persistent disk)
# UPLOAD_DIR=/var/data/uploads
EOF
